# ════════════════════════════════════════════════════════════════
#  Setelan deploy SILKABK + SPK Skrining Anak
#  Salin menjadi .env lalu isi:   cp .env.example .env
#  File .env berisi rahasia — JANGAN di-commit.
# ════════════════════════════════════════════════════════════════

# ─── Alamat publik (WAJIB beda host/subdomain) ──────────────
# Dua subdomain berbeda agar cookie login kedua sistem tidak saling menimpa.
SILKABK_URL=https://silkabk.domain.id
SPK_URL=https://spk.domain.id

# true di server (HTTPS). Isi false hanya untuk uji lokal tanpa HTTPS.
SECURE_COOKIES=true

# ─── Port container Nginx di host ───────────────────────────
# Reverse proxy server (Nginx/Traefik/NPM) meneruskan:
#   silkabk.domain.id -> 127.0.0.1:SILKABK_PORT
#   spk.domain.id     -> 127.0.0.1:SPK_PORT
# BIND=127.0.0.1 berarti hanya bisa diakses dari server itu sendiri (lewat proxy).
SILKABK_BIND=127.0.0.1
SILKABK_PORT=8080
SPK_BIND=127.0.0.1
SPK_PORT=8081

# ─── Kunci aplikasi (beda untuk tiap sistem) ────────────────
# Buat dengan:  docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
SILKABK_APP_KEY=
SPK_APP_KEY=

# ─── Secret login otomatis SILKABK -> SPK ───────────────────
# Satu nilai, dipakai kedua sistem. Buat dengan:
#   docker run --rm php:8.2-cli php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
SSO_SECRET=

# ─── Password database (huruf & angka saja) ─────────────────
POSTGRES_PASSWORD=
SILKABK_DB_PASSWORD=
SPK_DB_PASSWORD=
# User baca-saja yang dipakai SPK untuk membaca database SILKABK
SILKABK_READER_PASSWORD=

# ─── Opsional ───────────────────────────────────────────────
LOG_LEVEL=warning
# Lokasi repo & file dump (default: susunan folder di README)
# SILKABK_PATH=..
# SPK_PATH=../../spk-skrining-anak-v2
# SILKABK_DUMP=../ta_bismillah.sql
# SPK_DUMP=../../spk-skrining-anak-v2/Database_UPTD_BLK-ABK.sql
