APP_NAME=SILKABK
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Lokal: http://127.0.0.1:8000  |  Server: https://silkabk.domain.id
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ta_bismillah
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Jangan diisi domain induk (mis. .domain.id) agar cookie tidak bentrok dengan SPK
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Integrasi SPK Skrining Anak ─────────────────────────────
# Alamat sistem SPK. Lokal pakai host BERBEDA dari SILKABK (localhost vs 127.0.0.1)
# supaya cookie login tidak saling menimpa. Server: https://spk.domain.id
SPK_SKRINING_URL=http://localhost:8001
# Secret login otomatis (SSO). HARUS SAMA dengan SILKABK_SSO_SECRET di .env SPK.
# Buat dengan: php -r "echo bin2hex(random_bytes(32));"
SPK_SKRINING_SSO_SECRET=

# ─── Docker (docker-compose.yml) ─────────────────────────────
# Di SERVER isi juga nilai di atas seperti ini:
#   APP_ENV=production   APP_DEBUG=false   LOG_LEVEL=warning
#   APP_URL=https://silkabk.domain.id
#   APP_KEY=   (buat: docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;")
#   DB_USERNAME=silkabk_user   DB_PASSWORD=<password kuat>
#   (DB_HOST otomatis "db" di dalam Docker)
#   SPK_SKRINING_URL=https://spk.domain.id   SPK_SKRINING_SSO_SECRET=<sama dengan SPK>
#   SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

# Port di host. FRONTEND = Nginx (HTTP, tujuan reverse proxy),
# BACKEND = PHP-FPM (FastCGI, bukan HTTP).
FRONTEND_PORT=8818
FRONTEND_BIND=0.0.0.0
BACKEND_PORT=8817
BACKEND_BIND=127.0.0.1

# Password user baca-saja "spk_reader" (dipakai SPK untuk membaca database ini).
# Isi SAMA PERSIS di .env SPK pada SILKABK_DB_PASSWORD.
SPK_READER_PASSWORD=

# Opsional
# UPTD_NETWORK=uptd-network          # jaringan Docker bersama dengan SPK
# DB_DUMP_FILE=./ta_bismillah.sql    # dump yang di-restore saat pertama kali
